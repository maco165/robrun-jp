{
  "name": "robrun-jp",
  "version": "0.1.0",
  "private": true,
  "description": "ROB RUN の公式アップデートを日本語と日本時間でまとめる非公式のファンサイト",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir ${ROBRUN_OUT:-dist}/.ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "e2e": "node scripts/e2e.mjs",
    "test": "node --import tsx --test --test-timeout=180000 tests/*.test.ts",
    "check:data": "tsx scripts/check-data.ts",
    "fetch:news": "tsx scripts/fetch-news.ts",
    "check:repo": "node scripts/check-repo.mjs",
    "summarize": "tsx scripts/summarize.ts",
    "check:news": "tsx scripts/check-news.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "1.77.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
